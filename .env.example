# Local PostgreSQL container settings. Copy to .env.local; never commit a populated .env.local file.
POSTGRES_HOST=localhost
POSTGRES_DB=northwind_resolve
POSTGRES_USER=northwind
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=4200
# Optional Phase 6 Gemini configuration. Leave the key empty until a real key is supplied locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=PT10S
GEMINI_MAX_OUTPUT_TOKENS=1024
# Optional Phase 7 Solana Devnet configuration. Keep signer files outside Git.
SOLANA_ENABLED=false
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=
SOLANA_COMMITMENT=confirmed
SOLANA_TIMEOUT=PT10S
SOLANA_RETRY_DELAY=PT5M
