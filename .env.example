# Local PostgreSQL container settings. Copy to .env.local; never commit a populated .env.local file.
POSTGRES_HOST=localhost
POSTGRES_DB=northwind_resolve
POSTGRES_USER=northwind
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=4200
# Optional Phase 6 Gemini configuration. Leave the key empty until a real key is supplied locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=PT10S
GEMINI_MAX_OUTPUT_TOKENS=1024
